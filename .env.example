# OpenAI Configuration (REQUIRED)
OPENAI_API_KEY=your-openai-api-key-here

# Supabase Configuration (REQUIRED for REST API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key-here
SUPABASE_BUCKET=analytics-charts

# REST API Configuration
API_PORT=8080
JOB_CLEANUP_HOURS=1

# WebSocket Configuration (Legacy - not used in REST API version)
WEBSOCKET_PORT=8080
MAX_CONCURRENT_CONNECTIONS=100

# Chart Generation Settings
CHART_GENERATION_TIMEOUT=30
MAX_CHART_SIZE_MB=10

# Railway Deployment
RAILWAY_ENVIRONMENT=production

# Application Settings
APP_ENV=development
LOG_LEVEL=INFO
DEBUG=false
MAX_RETRIES=3

# ============================================
# Data Ingestion Agent Settings (v3.8.0)
# ============================================

# PostgreSQL Database (Railway)
# Required for data ingestion functionality
DATA_INGESTION_DATABASE_URL=postgresql://user:pass@host:port/railway

# Connection Pool Settings
DATA_INGESTION_DB_POOL_MIN_SIZE=5
DATA_INGESTION_DB_POOL_MAX_SIZE=20
DATA_INGESTION_DB_POOL_TIMEOUT=30

# Session Limits
DATA_INGESTION_SESSION_TTL_HOURS=1
DATA_INGESTION_MAX_FILE_SIZE_MB=10
DATA_INGESTION_MAX_ROWS_PER_SESSION=100000

# LLM Integration for Intent Parsing
# Optional: Falls back to rule-based parsing if not configured
DATA_INGESTION_OPENAI_API_KEY=your-openai-api-key-here
DATA_INGESTION_LLM_MODEL=gpt-4o-mini
DATA_INGESTION_LLM_TIMEOUT=30

# Agent Settings
DATA_INGESTION_MAX_AGENT_STEPS=10
DATA_INGESTION_QUERY_TIMEOUT=30
DATA_INGESTION_MAX_QUERY_ROWS=10000
